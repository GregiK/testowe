# Skopiuj do .env i uzupełnij prawdziwymi wartościami. Nigdy nie commituj pliku .env.

# --- Baza danych ---
# Lokalnie: docker compose up -d (patrz docker-compose.yml)
# Produkcyjnie (Aderlo Cloud): dane z panelu MySQL Databases (cPanel)
DATABASE_URL="mysql://app_user:app_password@localhost:3306/dating_app_dev"

# --- Sesje / bezpieczeństwo ---
# Losowy sekret min. 32 znaki, np.: openssl rand -base64 32
SESSION_SECRET="zmien-mnie-na-losowy-ciag-min-32-znaki"

# --- Aplikacja ---
NODE_ENV="development"
PORT="3000"
APP_BASE_URL="http://localhost:3000"

# --- Object storage na zdjęcia (do skonfigurowania w kolejnym etapie) ---
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Logowanie przez Google/Facebook (Etap 15) ---
# Brak tych zmiennych = przyciski logowania społecznościowego przekierują z powrotem
# na /login z czytelnym komunikatem "chwilowo niedostępne", zamiast błędu 500.
# Google: https://console.cloud.google.com/apis/credentials -> "Create OAuth client ID"
# (typ: Web application), Authorized redirect URI: <APP_BASE_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facebook: https://developers.facebook.com/apps -> Twoja aplikacja -> Facebook Login ->
# Settings -> Valid OAuth Redirect URIs: <APP_BASE_URL>/api/auth/oauth/facebook/callback
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Tryb demo (Etap 16) ---
# Gdy "true": na stronie głównej i logowania pojawia się sekcja "podgląd bez rejestracji"
# z 5 gotowymi kontami demo (patrz src/lib/demo.ts) - kliknięcie loguje bez hasła.
# WYŁĄCZONE DOMYŚLNIE. Włączaj tylko tymczasowo do własnego przeglądu aplikacji (np. na
# środowisku testowym) i wyłącz (usuń zmienną albo ustaw "false") przed udostępnieniem
# aplikacji prawdziwym użytkownikom - patrz docs/assumptions.md (Etap 16).
DEMO_MODE_ENABLED="false"
