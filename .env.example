# Skopiuj do .env i uzupełnij prawdziwymi wartościami. Nigdy nie commituj pliku .env.

# --- Baza danych ---
# Lokalnie: docker compose up -d (patrz docker-compose.yml)
# Produkcyjnie (Aderlo Cloud): dane z panelu MySQL Databases (cPanel)
DATABASE_URL="mysql://app_user:app_password@localhost:3306/dating_app_dev"

# --- Sesje / bezpieczeństwo ---
# Losowy sekret min. 32 znaki, np.: openssl rand -base64 32
SESSION_SECRET="zmien-mnie-na-losowy-ciag-min-32-znaki"

# --- Aplikacja ---
NODE_ENV="development"
PORT="3000"
APP_BASE_URL="http://localhost:3000"

# --- Object storage na zdjęcia (do skonfigurowania w kolejnym etapie) ---
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
