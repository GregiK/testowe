// Schemat bazy danych aplikacji randkowej.
// Provider: MySQL (dopasowany do hostingu Aderlo Cloud - 8 baz MySQL, brak PostgreSQL/PostGIS).
// Odległość geograficzna liczona w warstwie aplikacji (haversine na lat/lng), patrz src/lib/geo.ts.

generator client {
  provider      = "prisma-client-js"
  // Build dzieje się na Ubuntu (GitHub Actions), ale serwer produkcyjny (Aderlo Cloud) to
  // CloudLinux (RHEL-based) - bez jawnej listy silnik wygenerowałby się tylko pod system
  // budujący ("native") i mógłby nie działać na serwerze. Generujemy silniki pod oba warianty.
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SwipeAction {
  LIKE
  PASS
  SUPERLIKE
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ModerationEntityType {
  PROFILE
  PHOTO
  MESSAGE
}

enum SubscriptionPlan {
  FREE
  PLUS
  PREMIUM
}

// Konto użytkownika. Dane uwierzytelniające oddzielone od danych profilowych (Profile).
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  emailVerifiedAt   DateTime?
  isActive          Boolean   @default(true)
  isAdmin           Boolean   @default(false)
  deletedAt         DateTime? // soft delete - zgodność z prawem do usunięcia konta (RODO), retencja wg docs/assumptions.md
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  profile           Profile?
  sessions          Session[]
  photos            Photo[]
  sentSwipes        Swipe[]         @relation("SwipeInitiator")
  receivedSwipes    Swipe[]         @relation("SwipeTarget")
  matchesAsUserA    Match[]         @relation("MatchUserA")
  matchesAsUserB    Match[]         @relation("MatchUserB")
  messagesSent      Message[]
  blocksInitiated   Block[]         @relation("BlockInitiator")
  blocksReceived    Block[]         @relation("BlockTarget")
  reportsFiled      Report[]        @relation("ReportReporter")
  reportsReceived   Report[]        @relation("ReportTarget")
  notifications     Notification[]
  subscription      Subscription?
  auditLogs         AuditLog[]
  analyticsEvents   AnalyticsEvent[]

  @@index([deletedAt])
}

// Sesja logowania - rotacja przy odświeżeniu, unieważnienie przy zmianie hasła/wylogowaniu.
model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique // nigdy nie przechowuj surowego tokena sesji
  userAgent    String?  @db.VarChar(255)
  ipHash       String?  // zminimalizowane - hash IP, nie surowy adres
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Publiczny profil. Współrzędne przybliżone (zaokrąglone) - nie pokazujemy dokładnej lokalizacji.
model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  displayName   String   @db.VarChar(50)
  birthDate     DateTime // weryfikacja wieku 18+ liczona z tego pola, nie przechowujemy odrębnie "wieku"
  gender        Gender
  bio           String?  @db.VarChar(500)
  approxLat     Float?   // zaokrąglone do ok. 1-2 km, patrz docs/assumptions.md
  approxLng     Float?
  city          String?  @db.VarChar(100)
  isVisible     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos    Photo[]
  interests ProfileInterest[]
  preference Preference?

  @@index([isVisible])
  @@index([approxLat, approxLng])
}

model Interest {
  id       String @id @default(cuid())
  name     String @unique @db.VarChar(50)
  profiles ProfileInterest[]
}

model ProfileInterest {
  profileId  String
  interestId String

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([profileId, interestId])
}

// Preferencje wyszukiwania (discovery) danego użytkownika.
model Preference {
  id             String  @id @default(cuid())
  profileId      String  @unique
  minAge         Int     @default(18)
  maxAge         Int     @default(99)
  maxDistanceKm  Int     @default(50)
  interestedIn   Gender?
  updatedAt      DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Photo {
  id         String   @id @default(cuid())
  userId     String
  profileId  String?
  storageKey String   @db.VarChar(255) // klucz w object storage, nie publiczny URL wprost
  position   Int      @default(0)
  moderationStatus ReportStatus @default(OPEN) // OPEN=oczekuje moderacji do czasu zatwierdzenia
  createdAt  DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([profileId])
}

// Swipe - unikalna para (initiatorId, targetId), zapobiega duplikatom.
model Swipe {
  id            String      @id @default(cuid())
  initiatorId   String
  targetId      String
  action        SwipeAction
  createdAt     DateTime    @default(now())

  initiator User @relation("SwipeInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  target    User @relation("SwipeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([initiatorId, targetId])
  @@index([targetId])
}

// Match - tworzony atomowo w transakcji gdy istnieją wzajemne LIKE/SUPERLIKE.
// userAId/userBId zawsze kanonicznie posortowane (userAId < userBId), żeby wykluczyć duplikaty.
model Match {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  unmatchedAt DateTime?
  unmatchedBy String?

  userA    User      @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

// Wiadomość - dozwolona wyłącznie w kontekście istniejącego, nieusuniętego matchu (walidacja w API).
model Message {
  id        String   @id @default(cuid())
  matchId   String
  senderId  String
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  readAt    DateTime?

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
}

model Block {
  id          String   @id @default(cuid())
  initiatorId String
  targetId    String
  createdAt   DateTime @default(now())

  initiator User @relation("BlockInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  target    User @relation("BlockTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([initiatorId, targetId])
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  targetId     String
  entityType   ModerationEntityType
  entityId     String?
  reason       String       @db.VarChar(500)
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())

  reporter User            @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  target   User            @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Cascade)
  cases    ModerationCase[]

  @@index([status])
  @@index([targetId])
}

model ModerationCase {
  id         String       @id @default(cuid())
  reportId   String?
  entityType ModerationEntityType
  entityId   String
  status     ReportStatus @default(OPEN)
  reviewedBy String?      // adminUserId
  decision   String?      @db.VarChar(500)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @db.VarChar(50) // np. "new_match", "new_message"
  payload   String?  @db.Text
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Subscription {
  id            String            @id @default(cuid())
  userId        String            @unique
  plan          SubscriptionPlan  @default(FREE)
  startedAt     DateTime          @default(now())
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean       @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Log audytowy - akcje administracyjne i bezpieczeństwa. Nigdy nie loguj haseł/tokenów/treści wiadomości.
model AuditLog {
  id         String   @id @default(cuid())
  actorUserId String?
  action     String   @db.VarChar(100)
  targetType String?  @db.VarChar(50)
  targetId   String?
  metadata   String?  @db.Text
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
}

// Zdarzenia analityczne (Etap 13) - minimalny zestaw pod lejek aktywacji/retencji.
// Świadomie bez treści wiadomości, adresów IP czy innych danych wrażliwych - wyłącznie
// nazwa zdarzenia i krótkie, nieosobowe metadane (np. rodzaj swipe'a). Zgodnie z zasadą
// minimalizacji danych (RODO) - patrz docs/assumptions.md.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  name      String   @db.VarChar(50)
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId])
}
